# Application settings
RUSTFS_ENDPOINT=http://localhost:8080
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=password
RUSTFS_BUCKET=documents
RUSTFS_PREFIX=pdf
CRAWLER_REQUEST_DELAY_SECONDS=0.5

# RustFS web console: http://localhost:9001/rustfs/console/
# Sign in with the access key and secret key configured above.

# Optional: Postgres config if you want to use a local database alongside the container stack
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mydb
POSTGRES_USER=user
POSTGRES_PASSWORD=password
